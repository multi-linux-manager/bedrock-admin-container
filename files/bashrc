alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
export LS_OPTS='--color=auto'
alias ls='ls ${LS_OPTS}'
PS1='\[\033[01;31m\]\u\[\033[01;31m\]@BEDROCK-ADMIN\[\033[00m\]:\[\033[01;34m\]\w\[\033[01;36m\]$\[\033[00m\] '

echo "Welcome!

This container is used to make life easier for bedrock-admin users
"

if [ "$(ls -A ~/.aws)" ]; then
  echo "Seems you already configured everything required by bedrock-admin in the past

The guide for bedrock-admin is at https://github.com/SUSE/bedrock-toolkit/blob/main/admin-guide.md"
else 
  echo "Seems you still need to configure bedrock-admin.

Do it now by following
https://github.com/SUSE/bedrock-toolkit/blob/main/admin-guide.md
but without installing neither aws-cli nor bedrock-toolkit, as they are
already preinstalled

Just use aws or bedrock-admin commands as needed"
fi

echo -e "\033[1m
IMPORTANT! After doing changes to the yaml files, remember to commit and
push outside the container\033[0m"
